/* =========================================================
CARGAR API
========================================================= */

fetch(API)

.then(respuesta=>{

if(!respuesta.ok){

throw new Error(
"HTTP " +
respuesta.status
);

}

return respuesta.json();

})

.then(data=>{

if(!Array.isArray(data)){

