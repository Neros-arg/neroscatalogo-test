<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NERÓS | Perfumes & Fragancias</title>

<link rel="icon" type="image/png" href="favicon.png">

<style>

/* =========================================================
GENERAL
========================================================= */

*{
margin:0;
padding:0;
box-sizing:border-box;
}

:root{
--negro:#070707;
--negro2:#111111;
--negro3:#181818;
--dorado:#c89d38;
--dorado-claro:#f0c866;
--texto:#ffffff;
--gris:#a0a0a0;
--verde:#3ddc84;
--amarillo:#f5c542;
--rojo:#ff5a5a;
--whatsapp:#25D366;
}

html{
scroll-behavior:smooth;
}

body{
background:#080808;
font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
color:white;
padding-bottom:110px;
}


/* =========================================================
NAVBAR
========================================================= */

.navbar{
height:125px;
display:grid;
grid-template-columns:1fr auto 1fr;
align-items:center;
padding:0 55px;
background:#050505;
border-bottom:1px solid #171717;
position:relative;
z-index:100;
overflow:hidden;
}

.nav-left{
display:flex;
align-items:center;
gap:18px;
}

.nav-icon{
font-size:25px;
color:#ddd;
cursor:pointer;
background:none;
border:none;
}

.nav-center{
height:100%;
display:flex;
align-items:center;
justify-content:center;
overflow:hidden;
}

.logo-nav{
width:210px;
max-width:90%;
height:auto;
display:block;
transition:transform .35s ease,filter .35s ease;
}

.logo-nav:hover{
transform:scale(1.04);
filter:drop-shadow(0 0 15px rgba(200,157,56,.25));
}

.nav-right{
display:flex;
justify-content:flex-end;
align-items:center;
gap:18px;
}

.carrito-nav{
position:relative;
cursor:pointer;
font-size:25px;
transition:transform .2s ease;
}

.carrito-nav:hover{
transform:scale(1.12);
}

.carrito-numero{
position:absolute;
top:-9px;
right:-10px;
min-width:19px;
height:19px;
padding:0 4px;
border-radius:50px;
background:var(--dorado);
color:#111;
font-size:10px;
font-weight:bold;
display:flex;
align-items:center;
justify-content:center;
}


/* =========================================================
MENU
========================================================= */

.menu{
height:58px;
display:flex;
align-items:center;
justify-content:center;
gap:42px;
background:#080808;
border-bottom:1px solid #141414;
position:relative;
z-index:90;
}

.menu a{
color:white;
text-decoration:none;
font-size:13px;
font-weight:600;
transition:.2s;
}

.menu a:hover{
color:var(--dorado);
}


/* =========================================================
HERO
========================================================= */

.hero{
min-height:680px;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
position:relative;
overflow:hidden;

background:
linear-gradient(
rgba(0,0,0,.28),
rgba(0,0,0,.68)
),
url("fondo.png");

background-size:cover;
background-position:center;
}

.hero::after{
content:"";
position:absolute;
inset:0;

background:
linear-gradient(
90deg,
rgba(0,0,0,.55),
transparent 30%,
transparent 70%,
rgba(0,0,0,.55)
);

pointer-events:none;
}

.hero-contenido{
position:relative;
z-index:2;
max-width:850px;
padding:30px;
}

.hero-mini{
color:var(--dorado-claro);
letter-spacing:5px;
font-size:12px;
font-weight:800;
margin-bottom:18px;
}

.hero h1{
font-family:Georgia,"Times New Roman",serif;
font-size:56px;
line-height:1.08;
font-weight:500;
text-shadow:0 4px 30px rgba(0,0,0,.8);
}

.hero p{
margin:18px auto 27px;
max-width:650px;
font-size:16px;
line-height:1.6;
color:#e5e5e5;
}

.hero-botones{
display:flex;
justify-content:center;
gap:12px;
flex-wrap:wrap;
}

.hero-btn{
padding:14px 25px;
border-radius:6px;
text-decoration:none;
font-size:13px;
font-weight:800;
transition:.2s;
position:relative;
overflow:hidden;
}

.hero-btn.principal{
background:var(--dorado);
color:#111;
}

.hero-btn.principal:hover{
background:var(--dorado-claro);
}

.hero-btn.secundario{
background:rgba(0,0,0,.5);
border:1px solid rgba(255,255,255,.55);
color:white;
}

.hero-btn.secundario:hover{
border-color:var(--dorado);
color:var(--dorado-claro);
}

.hero-btn::before{
content:"";
position:absolute;
top:0;
left:-120%;
width:70%;
height:100%;

background:
linear-gradient(
90deg,
transparent,
rgba(255,255,255,.22),
transparent
);

transform:skewX(-20deg);
transition:.7s;
}

.hero-btn:hover::before{
left:150%;
}


/* =========================================================
ANIMACIONES
========================================================= */

@media(prefers-reduced-motion:no-preference){

.hero{
animation:heroBackgroundMove 18s ease-in-out infinite alternate;
}

@keyframes heroBackgroundMove{

0%{
background-size:100% auto;
background-position:center 48%;
}

100%{
background-size:108% auto;
background-position:center 52%;
}

}

.hero-mini{
opacity:0;
animation:fadeDown .8s ease forwards;
animation-delay:.15s;
}

.hero h1{
opacity:0;
transform:translateY(25px);
animation:heroTitle 1s cubic-bezier(.2,.8,.2,1) forwards;
animation-delay:.35s;
}

.hero p{
opacity:0;
transform:translateY(20px);
animation:fadeUp .9s ease forwards;
animation-delay:.65s;
}

.hero-botones{
opacity:0;
transform:translateY(15px);
animation:fadeUp .8s ease forwards;
animation-delay:.9s;
}

@keyframes heroTitle{

0%{
opacity:0;
transform:translateY(28px) scale(.97);
}

100%{
opacity:1;
transform:translateY(0) scale(1);
}

}

@keyframes fadeUp{

0%{
opacity:0;
transform:translateY(20px);
}

100%{
opacity:1;
transform:translateY(0);
}

}

@keyframes fadeDown{

0%{
opacity:0;
transform:translateY(-12px);
}

100%{
opacity:1;
transform:translateY(0);
}

}

}


/* =========================================================
BENEFICIOS
========================================================= */

.beneficios{
display:grid;
grid-template-columns:repeat(3,1fr);
max-width:1200px;
margin:0 auto;
border-left:1px solid #222;
border-right:1px solid #222;
}

.beneficio{
padding:28px 20px;
text-align:center;
background:#0d0d0d;
border-right:1px solid #222;
transition:transform .3s ease,background .3s ease;
}

.beneficio:hover{
transform:translateY(-4px);
background:#111;
}

.beneficio:last-child{
border-right:none;
}

.beneficio-icono{
font-size:25px;
margin-bottom:8px;
}

.beneficio strong{
display:block;
font-size:13px;
margin-bottom:5px;
color:#eee;
}

.beneficio span{
font-size:11px;
color:#777;
}


/* =========================================================
MEDIOS DE PAGO
========================================================= */

.medios-pago{
padding:55px 20px;
background:#0b0b0b;
border-top:1px solid #1d1d1d;
border-bottom:1px solid #1d1d1d;
text-align:center;
}

.medios-pago-titulo small{
color:var(--dorado);
font-size:10px;
font-weight:800;
letter-spacing:4px;
}

.medios-pago-titulo h3{
font-family:Georgia,"Times New Roman",serif;
font-size:32px;
font-weight:500;
margin-top:8px;
}

.medios-pago-titulo p{
color:#888;
font-size:13px;
margin-top:7px;
}

.medios-pago-opciones{
max-width:950px;
margin:30px auto 0;
display:grid;
grid-template-columns:repeat(5,1fr);
gap:10px;
}

.medio-pago{
min-height:120px;
padding:20px 10px;
background:#111;
border:1px solid #252525;
border-radius:16px;

display:flex;
flex-direction:column;
align-items:center;
justify-content:center;

transition:.25s ease;
}

.medio-pago:hover{
transform:translateY(-4px);
border-color:rgba(200,157,56,.65);
background:#151515;
}

.medio-pago span{
font-size:25px;
margin-bottom:9px;
}

.medio-pago strong{
font-size:12px;
color:#eee;
}

.medio-pago small{
font-size:10px;
color:var(--dorado-claro);
margin-top:5px;
}

.mercadopago-point{
margin:22px auto 0;
font-size:11px;
color:#777;
}


/* =========================================================
CATALOGO
========================================================= */

.catalogo{
padding:70px 25px 30px;

background:
radial-gradient(
circle at top,
rgba(200,157,56,.06),
transparent 25%
),
#090909;
}

.catalogo-cabeza{
text-align:center;
max-width:800px;
margin:0 auto 35px;
}

.catalogo-cabeza small{
color:var(--dorado);
font-size:11px;
letter-spacing:4px;
font-weight:bold;
}

.catalogo-cabeza h2{
font-family:Georgia,"Times New Roman",serif;
font-size:40px;
font-weight:500;
margin-top:10px;
}

.catalogo-cabeza p{
color:#888;
font-size:13px;
margin-top:10px;
}


/* =========================================================
CONTROLES
========================================================= */

.controles{
max-width:950px;
margin:0 auto 38px;
padding:11px;
background:rgba(18,18,18,.95);
border:1px solid #292929;
border-radius:15px;
}

.modos{
display:flex;
gap:8px;
margin-bottom:9px;
}

.modo{
flex:1;
padding:13px;
border-radius:9px;
border:1px solid #333;
background:#171717;
color:#999;
font-size:13px;
font-weight:800;
cursor:pointer;
transition:.2s;
}

.modo:hover{
border-color:var(--dorado);
color:white;
}

.modo.activo{
background:var(--dorado);
border-color:var(--dorado);
color:#111;
}

.buscar-wrap{
position:relative;
}

.buscar-icono{
position:absolute;
left:15px;
top:50%;
transform:translateY(-50%);
opacity:.6;
}

#buscar{
width:100%;
padding:14px 15px 14px 43px;
background:#111;
color:white;
border:1px solid #2e2e2e;
border-radius:9px;
font-size:14px;
outline:none;
}

#buscar:focus{
border-color:var(--dorado);
}


/* =========================================================
PRODUCTOS
========================================================= */

#productos{
display:grid;
grid-template-columns:repeat(5,minmax(0,1fr));
gap:18px;
max-width:1600px;
margin:auto;
}

.card{
background:#141414;
border:1px solid #242424;
border-radius:20px;
transition:.25s;
overflow:hidden;
position:relative;
}

.card:hover{
border-color:rgba(200,157,56,.75);
transform:translateY(-4px);
box-shadow:0 18px 45px rgba(0,0,0,.45);
}

.imagen-producto{
position:relative;
aspect-ratio:1 / 1.12;
overflow:hidden;
background:#191919;
}

.card img{
width:100%;
height:100%;
object-fit:cover;
display:block;
transition:transform .6s cubic-bezier(.2,.8,.2,1);
}

.card:hover img{
transform:scale(1.07);
}

.stock-badge{
position:absolute;
top:10px;
left:10px;
max-width:calc(100% - 20px);
padding:7px 9px;
border-radius:20px;
font-size:10px;
font-weight:bold;
background:rgba(0,0,0,.80);
backdrop-filter:blur(8px);
border:1px solid #333;
}

.stock-badge.disponible{
color:var(--verde);
}

.stock-badge.apedido{
color:var(--amarillo);
}

.stock-badge.sinstock{
color:var(--rojo);
}

.info{
padding:15px;
}

.nombre{
font-size:14px;
font-weight:700;
line-height:1.35;
min-height:58px;
}

.precio-anterior{
font-size:14px;
color:#777;
text-decoration:line-through;
margin-top:10px;
}

.precio{
font-size:24px;
font-weight:900;
color:var(--dorado-claro);
margin-top:3px;
}

.descuento{
margin-top:8px;
padding:7px;
text-align:center;
font-size:10px;
font-weight:bold;
border:1px solid rgba(61,220,132,.25);
background:rgba(61,220,132,.08);
color:var(--verde);
border-radius:8px;
}

.mayorista-titulo{
font-size:11px;
color:var(--dorado);
font-weight:bold;
margin-top:12px;
}

.mayorista-precio{
font-size:23px;
font-weight:900;
color:var(--dorado-claro);
margin-top:4px;
}

.mayorista-info{
font-size:11px;
line-height:1.6;
color:#888;
margin-top:8px;
padding:8px;
background:#0d0d0d;
border:1px solid #222;
border-radius:8px;
}

.agregar{
width:100%;
border:none;
border-radius:10px;
padding:12px;
margin-top:13px;
background:var(--dorado);
color:#111;
font-size:11px;
font-weight:900;
cursor:pointer;
transition:.2s;
position:relative;
overflow:hidden;
}

.agregar:hover{
background:var(--dorado-claro);
}

.agregar:disabled{
background:#292929;
color:#777;
cursor:not-allowed;
}

.agregar::after{
content:"";
position:absolute;
inset:0;

background:
linear-gradient(
110deg,
transparent 20%,
rgba(255,255,255,.22) 45%,
transparent 70%
);

transform:translateX(-150%);
transition:.65s;
}

.agregar:hover::after{
transform:translateX(150%);
}

.cantidad{
display:flex;
align-items:center;
justify-content:center;
gap:9px;
margin-top:13px;
}

.cantidad button{
width:35px;
height:35px;
border-radius:8px;
background:#202020;
border:1px solid #3a3a3a;
color:white;
font-size:18px;
cursor:pointer;
}

.cantidad span{
width:32px;
text-align:center;
font-weight:bold;
}


/* =========================================================
PAGINACION
========================================================= */

.paginacion{
display:flex;
justify-content:center;
align-items:center;
flex-wrap:wrap;
gap:6px;
margin:40px auto 15px;
}

.pagina-btn{
min-width:40px;
height:40px;
padding:0 11px;
border-radius:8px;
border:1px solid #333;
background:#151515;
color:#999;
cursor:pointer;
}

.pagina-btn.activa{
background:var(--dorado);
color:#111;
border-color:var(--dorado);
}

.pagina-btn:hover{
border-color:var(--dorado);
color:white;
}

.pagina-btn:disabled{
opacity:.3;
cursor:not-allowed;
}

.paginacion-info{
text-align:center;
font-size:11px;
color:#666;
}


/* =========================================================
CARRITO FLOTANTE
========================================================= */

.carrito-barra{
position:fixed;
bottom:0;
left:0;
right:0;
z-index:1000;
display:none;
background:rgba(8,8,8,.96);
border-top:1px solid #333;
backdrop-filter:blur(15px);
padding:12px 20px;
}

.carrito-contenido{
max-width:1000px;
margin:auto;
display:flex;
justify-content:space-between;
align-items:center;
gap:20px;
}

.carrito-info{
font-size:13px;
color:#ccc;
}

.carrito-info strong{
color:var(--dorado-claro);
}

.carrito-boton{
padding:13px 20px;
border-radius:10px;
background:var(--whatsapp);
border:none;
color:white;
font-size:12px;
font-weight:900;
cursor:pointer;
}


/* =========================================================
MODAL
========================================================= */

.modal{
position:fixed;
inset:0;
z-index:3000;
display:none;
align-items:center;
justify-content:center;
padding:15px;
background:rgba(0,0,0,.82);
}

.modal.activo{
display:flex;
}

.modal-contenido{
width:100%;
max-width:650px;
max-height:90vh;
overflow-y:auto;
padding:22px;
background:#141414;
border:1px solid #333;
border-radius:18px;
}

.modal-header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:18px;
}

.modal-header h2{
font-family:Georgia,serif;
font-size:24px;
font-weight:500;
}

.cerrar{
border:none;
background:none;
color:#999;
font-size:28px;
cursor:pointer;
}

.pago-selector{
display:none;
grid-template-columns:1fr 1fr;
gap:8px;
margin-bottom:15px;
}

.pago-selector.activo{
display:grid;
}

.pago-btn{
padding:11px;
border-radius:9px;
background:#1c1c1c;
border:1px solid #333;
color:#aaa;
font-size:11px;
font-weight:bold;
cursor:pointer;
}

.pago-btn.activo{
border-color:var(--dorado);
color:var(--dorado-claro);
background:rgba(200,157,56,.1);
}

.item-carrito{
display:flex;
align-items:center;
justify-content:space-between;
gap:12px;
padding:14px 0;
border-bottom:1px solid #292929;
}

.item-nombre{
font-size:13px;
font-weight:bold;
}

.item-precio{
font-size:11px;
color:#999;
margin-top:4px;
}

.item-subtotal{
font-size:11px;
color:var(--dorado);
margin-top:4px;
}

.item-controles{
display:flex;
align-items:center;
gap:7px;
}

.item-controles button{
width:30px;
height:30px;
border-radius:7px;
background:#222;
border:1px solid #444;
color:white;
cursor:pointer;
}

.item-controles span{
min-width:25px;
text-align:center;
}

.carrito-resumen{
margin-top:18px;
padding-top:15px;
border-top:1px solid #444;
}

.resumen-linea{
display:flex;
justify-content:space-between;
font-size:13px;
margin-bottom:8px;
}

.resumen-total{
display:flex;
justify-content:space-between;
margin-top:12px;
padding-top:12px;
border-top:1px solid #333;
font-size:21px;
font-weight:900;
color:var(--dorado-claro);
}

.proximo-nivel{
margin-top:14px;
padding:10px;
border-radius:9px;
font-size:11px;
line-height:1.5;
text-align:center;
color:#ccc;
border:1px solid rgba(200,157,56,.22);
background:rgba(200,157,56,.07);
}

.enviar-whatsapp{
width:100%;
padding:15px;
margin-top:18px;
border-radius:10px;
border:none;
background:var(--whatsapp);
color:white;
font-size:13px;
font-weight:900;
cursor:pointer;
}

.enviar-whatsapp:disabled{
background:#333;
color:#777;
cursor:not-allowed;
}


/* =========================================================
FOOTER
========================================================= */

.footer{
padding:55px 20px 35px;
background:#050505;
border-top:1px solid #191919;
text-align:center;
}

.footer img{
width:150px;
margin-bottom:17px;
}

.footer p{
font-size:11px;
color:#666;
line-height:1.7;
}


/* =========================================================
RESPONSIVE
========================================================= */

