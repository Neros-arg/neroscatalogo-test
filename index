/* =========================================================
RENDER CARRITO
========================================================= */

function renderCarrito(){

const lista=

document
.getElementById(
"listaCarrito"
);

const resumen=

document
.getElementById(
"resumenCarrito"
);

const boton=

document
.getElementById(
"btnWhatsApp"
);

if(
carrito.length===0
){

lista.innerHTML=`

<div style="
padding:30px;
text-align:center;
color:#888;
">

Tu pedido está vacío.

</div>

`;

resumen.innerHTML="";

boton.disabled=true;

return;

}


const total=

totalUnidades();


let totalPedido=
0;


lista.innerHTML=
"";


carrito.forEach(item=>{

