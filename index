const info=

document
.getElementById(
"carritoInfo"
);

const numero=

document
.getElementById(
"carritoNumero"
);

numero.textContent=
unidades;

if(
unidades>0
){

barra.style.display=
"block";

const total=

obtenerTotalCarrito();

info.innerHTML=`

🛒

<strong>
${unidades}
</strong>

unidades ·

<strong>

$
${
Math.round(total)
.toLocaleString("es-AR")
}

</strong>

`;

}

else{

barra.style.display=
"none";

}

if(

document
.getElementById(
"modalCarrito"
)
.classList
.contains(
"activo"
)

){

renderCarrito();

}

}


