/* =========================================================
ESCAPE HTML
========================================================= */

function escapeHTML(text){

return String(text)

.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =========================================================
ESCAPE ATRIBUTO
========================================================= */

function escapeAttr(text){

return String(text)

.replace(/\\/g,"\\\\")
.replace(/'/g,"\\'")
.replace(/\r?\n/g," ");

}


