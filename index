function mostrarPagina(){

const inicio=

(paginaActual-1) *
PRODUCTOS_POR_PAGINA;

const fin=

inicio +
PRODUCTOS_POR_PAGINA;

mostrar(

productosFiltrados.slice(
inicio,
fin
)

);

mostrarPaginacion();

}


/* =========================================================
STOCK
========================================================= */

function clasificarStock(stock){

const texto=

(stock || "")
.toLowerCase();

if(
texto.includes("sin stock")
){

return "sinstock";

}

if(
texto.includes("disponible") &&
!texto.includes("pedido")
){

return "disponible";

}

return "apedido";

}


function productoNoVendible(producto){

return (

producto.stock || ""

)
.toLowerCase()
.includes(
"sin stock"
);

}


/* =========================================================
MOSTRAR PRODUCTOS
========================================================= */

function mostrar(lista){

const cont=

document
.getElementById(
"productos"
);

cont.innerHTML="";

if(
lista.length===0
){

cont.innerHTML=`

<div style="
grid-column:1/-1;
text-align:center;
padding:50px;
color:#888;
">

No encontramos productos
con esa búsqueda.

</div>

`;

return;

}


lista.forEach(producto=>{

const claseStock=

clasificarStock(
producto.stock
);

const precioLista=

Number(
producto.precio
) || 0;

const precioEfectivo=

precioLista *
0.90;

const precio10=

Number(
producto.precioMayorista10
) || 0;

const precio20=

Number(
producto.precioMayorista20
) || 0;

const precio30=

Number(
producto.precioMayorista30
) || 0;

const formato={

minimumFractionDigits:0,
maximumFractionDigits:0

};

let precioHTML="";


/* =====================================================
PARTICULAR
===================================================== */

if(
modoActual==="particular"
){

precioHTML=`

<div class="precio-anterior">

$ ${
precioLista.toLocaleString(
"es-AR",
formato
)
}

</div>


<div class="precio">

💸 $
${
precioEfectivo.toLocaleString(
"es-AR",
formato
)
}

</div>


<div class="descuento">

10% OFF · Efectivo o transferencia

</div>

`;

}


/* =====================================================
MAYORISTA
===================================================== */

else{

const total=
totalUnidades();

let precioMostrar=
precio10;

let titulo=
"Precio mayorista 10+";

if(
total>=30
){

precioMostrar=
precio30;

titulo=
"Precio mayorista 30+";

}

else if(
total>=20
){

precioMostrar=
precio20;

titulo=
"Precio mayorista 20+";

}

precioHTML=`

<div class="mayorista-titulo">

📦 ${titulo}

</div>


<div class="mayorista-precio">

$
${
precioMostrar.toLocaleString(
"es-AR",
formato
)
}

</div>


<div class="mayorista-info">

10+ →
$
${precio10.toLocaleString("es-AR")}

<br>

20+ →
$
${precio20.toLocaleString("es-AR")}

<br>

30+ →
$
${precio30.toLocaleString("es-AR")}

</div>

`;

}


/* =====================================================
BOTON
===================================================== */

const cantidadActual=

obtenerCantidad(
producto.perfume
);

let botonHTML="";

if(
productoNoVendible(
producto
)
){

botonHTML=`

<button
class="agregar"
disabled>

❌ SIN STOCK

</button>

`;

}

else if(
cantidadActual>0
){

botonHTML=`

<div class="cantidad">

<button
onclick="
cambiarCantidad(
'${escapeAttr(producto.perfume)}',
-1
)
">

−

</button>

<span>
${cantidadActual}
</span>

<button
onclick="
cambiarCantidad(
'${escapeAttr(producto.perfume)}',
1
)
">

+

</button>

</div>

`;

}

else{

botonHTML=`

<button
class="agregar"
onclick="
agregarProducto(
'${escapeAttr(producto.perfume)}'
)
">

➕ AGREGAR AL PEDIDO

</button>

`;

}


/* =====================================================
CARD
===================================================== */

cont.innerHTML+=`

<div class="card">


<div class="imagen-producto">

<img

src="${
escapeHTML(

producto.foto ||

'https://placehold.co/600x800/222222/888888?text=NERÓS'

)
}"

alt="${
escapeHTML(
producto.perfume ||
'Producto NERÓS'
)
}"

loading="lazy"

onerror="
this.onerror=null;
this.src=
'https://placehold.co/600x800/222222/888888?text=NERÓS';
">


<div
class="
stock-badge
${claseStock}
">

${
escapeHTML(
producto.stock || ""
)
}

</div>

</div>


<div class="info">

<div class="nombre">

${
escapeHTML(
producto.perfume
)
}

</div>

${precioHTML}

${botonHTML}

</div>

</div>

`;

});

}


/* =========================================================
PAGINACION
========================================================= */

function mostrarPaginacion(){

const cont=

document
.getElementById(
"paginacion"
);

const totalPaginas=

Math.ceil(

productosFiltrados.length /

PRODUCTOS_POR_PAGINA

);

if(
totalPaginas<=1
){

cont.innerHTML="";

return;

}

let html=

`<div class="paginacion">`;

html+=`

<button

class="pagina-btn"

onclick="
cambiarPagina(
${paginaActual-1}
)
"

${
paginaActual===1
?
"disabled"
:
""
}>

‹

</button>

`;

for(
let i=1;
i<=totalPaginas;
i++
){

if(

totalPaginas>8 &&

i!==1 &&

i!==totalPaginas &&

Math.abs(
i-paginaActual
)>2

){

if(

i===2 ||

i===totalPaginas-1

){

html+=`

<span style="
color:#666;
padding:0 3px;
">

...

</span>

`;

}

continue;

}

html+=`

<button

class="
pagina-btn
${
i===paginaActual
?
"activa"
:
""
}
"

onclick="
cambiarPagina(${i})
">

${i}

</button>

`;

}

html+=`

<button

class="pagina-btn"

onclick="
cambiarPagina(
${paginaActual+1}
)
"

${
paginaActual===totalPaginas
?
"disabled"
:
""
}>

›

</button>

`;

html+=
`</div>`;


const inicio=

((paginaActual-1) *
PRODUCTOS_POR_PAGINA)
+1;


const fin=

Math.min(

paginaActual *
PRODUCTOS_POR_PAGINA,

productosFiltrados.length

);


html+=`

<div class="paginacion-info">

Mostrando
${inicio}–${fin}
de
${productosFiltrados.length}
productos

</div>

`;


cont.innerHTML=
html;

}


/* =========================================================
CAMBIAR PAGINA
========================================================= */

function cambiarPagina(pagina){

const totalPaginas=

Math.ceil(

productosFiltrados.length /

PRODUCTOS_POR_PAGINA

);

if(

pagina<1 ||

pagina>totalPaginas

){

return;

}

paginaActual=
pagina;

mostrarPagina();

document
.getElementById(
"catalogo"
)
.scrollIntoView({

behavior:"smooth"

});

}


/* =========================================================
CANTIDAD
========================================================= */

function obtenerCantidad(perfume){

const item=

carrito.find(

producto=>

producto.perfume===
perfume

);

return item
?
item.cantidad
:
0;

}


/* =========================================================
AGREGAR
========================================================= */

function agregarProducto(perfume){

const producto=

perfumes.find(

item=>

item.perfume===
perfume

);

if(

!producto ||

productoNoVendible(
producto
)

){

return;

}

const existente=

carrito.find(

item=>

item.perfume===
perfume

);

if(existente){

existente.cantidad++;

}

else{

carrito.push({

perfume:
producto.perfume,

cantidad:
1,

precio:
Number(
producto.precio
) || 0,

precioMayorista10:
Number(
producto.precioMayorista10
) || 0,

precioMayorista20:
Number(
producto.precioMayorista20
) || 0,

precioMayorista30:
Number(
producto.precioMayorista30
) || 0

});

}

actualizarCarrito();

mostrarPagina();

}


/* =========================================================
CAMBIAR CANTIDAD
========================================================= */

function cambiarCantidad(
perfume,
cambio
){

const item=

carrito.find(

producto=>

producto.perfume===
perfume

);

if(!item){

if(cambio>0){

agregarProducto(
perfume
);

}

return;

}

item.cantidad+=
cambio;

if(
item.cantidad<=0
){

carrito=

carrito.filter(

producto=>

producto.perfume!==
perfume

);

}

actualizarCarrito();

mostrarPagina();

}


/* =========================================================
TOTAL UNIDADES
========================================================= */

function totalUnidades(){

return carrito.reduce(

(total,item)=>

total +
item.cantidad,

0

);

}


/* =========================================================
PRECIO ITEM
========================================================= */

function obtenerPrecioItem(
item,
total
){

if(
modoActual==="mayorista"
){

if(total>=30){

return (
Number(
item.precioMayorista30
) || 0
);

}

if(total>=20){

return (
Number(
item.precioMayorista20
) || 0
);

}

return (
Number(
item.precioMayorista10
) || 0
);

}

const precioLista=

Number(
item.precio
) || 0;

return formaPago==="efectivo"
?
precioLista * 0.90
:
precioLista;

}


/* =========================================================
TOTAL CARRITO
========================================================= */

function obtenerTotalCarrito(){

const unidades=

totalUnidades();

return carrito.reduce(

(suma,item)=>{

const precio=

obtenerPrecioItem(
item,
unidades
);

return suma +
(
precio *
item.cantidad
);

},

0

);

}


/* =========================================================
ACTUALIZAR CARRITO
========================================================= */

function actualizarCarrito(){

const unidades=

totalUnidades();

const barra=

document
.getElementById(
"carritoBarra"
